{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Culprit",
  "mainBinaryName": "Culprit",
  "version": "0.1.0",
  "identifier": "app.culprit.lagfinder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Culprit",
        "width": 1120,
        "height": 740,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "shadow": true,
        "resizable": true,
        "backgroundColor": "#0a0a0a",
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "publisher": "Culprit",
    "copyright": "",
    "shortDescription": "Finds what made your game lag or stutter."
  }
}
